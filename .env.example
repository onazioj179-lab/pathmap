# PATHMAP V100+ - Secure Environment Configuration
# ============================================
# Copy this file to .env and configure values
# NEVER commit .env to version control!

# ============== REQUIRED SECURITY ==============

# Database (PostgreSQL) - REQUIRED
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_USE_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://pathmap:${POSTGRES_PASSWORD}@localhost:5432/pathmap

# JWT Authentication - REQUIRED IN PRODUCTION
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# Application Secret - REQUIRED
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ============== APPLICATION ==============

# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
REQUEST_LOGGING=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000

# ============== SECURITY (V100+) ==============

# CORS - Comma-separated allowed origins (NO WILDCARDS IN PRODUCTION!)
# Example: https://app.pathmap.com,https://pathmap.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Request-ID
CORS_ALLOW_CREDENTIALS=true

# HTTPS redirect in production
FORCE_HTTPS=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=60

# Request Size Limits (bytes)
MAX_REQUEST_SIZE=1048576

# ============== PUSH NOTIFICATIONS (V97) ==============

# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@pathmap.app

# FCM (Firebase) - Optional
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=

# APNS (iOS) - Optional
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.pathmap.app

# ============== TILE SERVERS ==============

# Primary tile server
TILE_SERVER_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Fallback tile servers (comma-separated)
TILE_FALLBACK_SERVERS=https://a.tile.openstreetmap.org/{z}/{x}/{y}.png,https://b.tile.openstreetmap.org/{z}/{x}/{y}.png

# Premium providers (optional)
MAPBOX_ACCESS_TOKEN=
MAPTILER_API_KEY=

# ============== EMAIL ==============

SENDGRID_API_KEY=
FROM_EMAIL=noreply@pathmap.com
FROM_NAME=PathMap

# ============== MONITORING & OBSERVABILITY ==============

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Health Check
HEALTH_CHECK_PATH=/health

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Debug (disable in production)
PATHMAP_DEBUG=false

# ============== RESOURCE LIMITS ==============

# User Limits
MAX_DEVICES_PER_USER=10
MAX_GEOFENCES_PER_USER=50
LOCATION_HISTORY_DAYS=30
MAX_SHARE_LINK_HOURS=168

# Container Resource Limits (Docker)
BACKEND_CPU_LIMIT=2
BACKEND_MEMORY_LIMIT=2g
FRONTEND_CPU_LIMIT=1
FRONTEND_MEMORY_LIMIT=512m
POSTGRES_CPU_LIMIT=2
POSTGRES_MEMORY_LIMIT=2g
REDIS_CPU_LIMIT=1
REDIS_MEMORY_LIMIT=512m
RESTART_POLICY=unless-stopped

# ============== FEATURE FLAGS ==============

REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=true
TWO_FACTOR_ENABLED=false
SOCIAL_LOGIN_ENABLED=false
