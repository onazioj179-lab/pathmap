{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/components/AmbientModeIndicator.tsx",
    "src/components/AntiLostModeUI.tsx",
    "src/components/BatteryWarningPanel.tsx",
    "src/components/SensorDiagnosticsPanel.tsx",
    "src/components/SensorFusionIndicator.tsx",
    "src/components/PredictiveSuggestionPanel.tsx",
    "src/components/WorldConditionsPanel.tsx",
    "src/components/ThemeControlPanel.tsx",
    "src/components/LiveNavigationIndicator.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
