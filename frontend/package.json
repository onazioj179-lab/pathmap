{
  "name": "pathfinder-frontend",
  "version": "98.0.0",
  "description": "Commercial encrypted location tracking and private navigation frontend for PathMap.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/validateWatermark.mjs && node ./scripts/buildIntegrity.mjs && vite build",
    "build:strict": "node ./scripts/validateWatermark.mjs && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:watermark": "node ./scripts/validateWatermark.mjs",
    "build:integrity": "node ./scripts/buildIntegrity.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "analyze": "vite build --mode analyze && npx vite-bundle-visualizer"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@sentry/react": "^10.51.0",
    "framer-motion": "^10.16.4",
    "gsap": "^3.15.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "mapbox-gl": "^2.15.0",
    "maplibre-gl": "^5.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.11.0",
    "web-vitals": "^3.5.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.32",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-bundle-visualizer": "^1.0.0",
    "vitest": "^4.0.16"
  }
}
